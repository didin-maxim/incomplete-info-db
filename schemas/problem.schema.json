{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incomplete Information Problem",
  "type": "object",
  "required": [
    "id",
    "title",
    "fragment",
    "kind",
    "language",
    "statements",
    "ideas",
    "strategies",
    "difficulty",
    "tags",
    "sources",
    "editorial"
  ],
  "$defs": {
    "figure": {
      "type": "object",
      "description": "Local image attached to a statement, idea, strategy, or proof. Images are stored as files, not embedded as base64.",
      "required": ["asset", "alt", "caption", "status"],
      "anyOf": [
        {"required": ["source_id"]},
        {"required": ["source_note"]}
      ],
      "properties": {
        "id": {"type": "string"},
        "asset": {
          "type": "string",
          "description": "Safe repository-relative path such as data/assets/images/<problem-id>/<name>.webp."
        },
        "alt": {"type": "string"},
        "caption": {"type": "string"},
        "source_id": {"type": "string"},
        "source_note": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "figure_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/figure"}
    }
  },
  "properties": {
    "statements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "figures": {"$ref": "#/$defs/figure_list"}
          }
        }
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figures": {"$ref": "#/$defs/figure_list"}
        }
      }
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figures": {"$ref": "#/$defs/figure_list"}
        }
      }
    },
    "impossibility_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figures": {"$ref": "#/$defs/figure_list"}
        }
      }
    },
    "fragment": {
      "type": "string",
      "description": "Primary navigation fragment: weighings, wise_people, card_tricks, questions, communication, impossibility."
    },
    "authors": {
      "type": "array",
      "description": "Known problem authors/proposers. Use only when backed by a source; unknown authors should be omitted.",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string"},
              "status": {"type": "string"},
              "source_id": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        ]
      }
    },
    "incomplete_information_profile": {
      "type": "object",
      "properties": {
        "hidden_state_space": {"type": "string"},
        "observations": {"type": "array", "items": {"type": "string"}},
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "goal": {"type": "array", "items": {"type": "string"}},
        "strategy_type": {"type": "array", "items": {"type": "string"}},
        "lower_bound_method": {"type": "array", "items": {"type": "string"}},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string"}
      }
    },
    "weighing_profile": {
      "type": "object",
      "properties": {
        "object_count": {"type": "integer"},
        "counterfeit_count": {"type": "integer"},
        "counterfeit_type": {"type": "string"},
        "weighing_count": {"type": "integer"},
        "outcome_count_per_weighing": {"type": "integer"},
        "adaptive": {"type": "boolean"},
        "objective": {"type": "string"}
      }
    },
    "interactive": {
      "type": "object",
      "description": "Optional viewer-side interactive task configuration. It must not contain solution steps or strategic hints.",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Renderer key used by the static viewer."
        },
        "coin_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of visually identical numbered coins."
        },
        "counterfeit_weight": {
          "type": "string",
          "enum": ["lighter", "heavier"],
          "description": "Known direction of the single counterfeit coin."
        },
        "max_weighings": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of balance-scale weighings allowed."
        },
        "objective": {
          "type": "string",
          "enum": ["identify_coin"],
          "description": "Goal checked by the interactive layer."
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["random", "challenge", "sandbox", "guided"]
          },
          "uniqueItems": true
        },
        "require_equal_pan_counts": {
          "type": "boolean",
          "description": "Whether the UI should require the two pans to contain the same number of coins before weighing."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "single_counterfeit_weighing"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "counterfeit_weight", "max_weighings", "objective"]
          }
        }
      ]
    },
    "knowledge_profile": {"type": "object"},
    "card_trick_profile": {"type": "object"},
    "questions_profile": {"type": "object"},
    "communication_profile": {"type": "object"}
  }
}
