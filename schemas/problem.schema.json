{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incomplete Information Problem",
  "type": "object",
  "required": [
    "id",
    "title",
    "fragment",
    "kind",
    "language",
    "statements",
    "ideas",
    "strategies",
    "difficulty",
    "tags",
    "sources",
    "editorial"
  ],
  "$defs": {
    "figure": {
      "type": "object",
      "description": "Local image attached to a statement, idea, strategy, or proof. Images are stored as files, not embedded as base64.",
      "required": ["asset", "alt", "caption", "status"],
      "anyOf": [
        {"required": ["source_id"]},
        {"required": ["source_note"]}
      ],
      "properties": {
        "id": {"type": "string"},
        "asset": {
          "type": "string",
          "description": "Safe repository-relative path such as data/assets/images/<problem-id>/<name>.webp."
        },
        "alt": {"type": "string"},
        "caption": {"type": "string"},
        "source_id": {"type": "string"},
        "source_note": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "figure_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/figure"}
    }
  },
  "properties": {
    "statements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "figures": {"$ref": "#/$defs/figure_list"}
          }
        }
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figures": {"$ref": "#/$defs/figure_list"}
        }
      }
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figures": {"$ref": "#/$defs/figure_list"}
        }
      }
    },
    "impossibility_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figures": {"$ref": "#/$defs/figure_list"}
        }
      }
    },
    "fragment": {
      "type": "string",
      "description": "Primary navigation fragment: weighings, wise_people, card_tricks, questions, communication, impossibility."
    },
    "authors": {
      "type": "array",
      "description": "Known problem authors/proposers. Use only when backed by a source; unknown authors should be omitted.",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string"},
              "status": {"type": "string"},
              "source_id": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        ]
      }
    },
    "incomplete_information_profile": {
      "type": "object",
      "properties": {
        "hidden_state_space": {"type": "string"},
        "observations": {"type": "array", "items": {"type": "string"}},
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "goal": {"type": "array", "items": {"type": "string"}},
        "strategy_type": {"type": "array", "items": {"type": "string"}},
        "lower_bound_method": {"type": "array", "items": {"type": "string"}},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string"}
      }
    },
    "weighing_profile": {
      "type": "object",
      "properties": {
        "object_count": {"type": "integer"},
        "counterfeit_count": {"type": "integer"},
        "counterfeit_type": {"type": "string"},
        "weighing_count": {"type": "integer"},
        "outcome_count_per_weighing": {"type": "integer"},
        "adaptive": {"type": "boolean"},
        "objective": {"type": "string"}
      }
    },
    "interactive": {
      "type": "object",
      "description": "Optional viewer-side interactive task configuration. It must not contain solution steps or strategic hints.",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Renderer key used by the static viewer."
        },
        "presentation": {
          "type": "string",
          "enum": ["exercise", "demonstration", "review_only"],
          "description": "How the viewer may present the interactive block. Omitted means exercise: the user must supply a strategy, move, answer, or plan that the viewer checks. Demonstration is only for an explicitly labeled walkthrough that substantially clarifies the official solution. Review-only keeps an unfinished candidate out of the public interactive surface."
        },
        "coin_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of visually identical numbered coins."
        },
        "object_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of named objects in non-weighing subset-test interactives."
        },
        "object_counts": {
          "type": "array",
          "items": {"type": "integer", "minimum": 2},
          "uniqueItems": true,
          "description": "Alternative object counts supported by one interactive renderer."
        },
        "item_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of ordered items in finite permutation-message interactives."
        },
        "card_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of physical cards or binary feature cards in card-trick interactives."
        },
        "deck_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of cards in the deck for card-trick interactives."
        },
        "hand_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of cards selected by the spectator."
        },
        "shown_cards": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of cards shown to the magician."
        },
        "hidden_cards": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of cards hidden from the magician."
        },
        "bit_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of binary questions or bit positions in finite number-guessing interactives."
        },
        "number_min": {
          "type": "integer",
          "minimum": 0,
          "description": "Smallest hidden number in finite number-guessing interactives."
        },
        "number_max": {
          "type": "integer",
          "minimum": 1,
          "description": "Largest hidden number in finite number-guessing interactives."
        },
        "card_weights": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true,
          "description": "Weights assigned to binary feature cards; selected cards are summed to decode the hidden number."
        },
        "repetitions_per_bit": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of repeated answers recorded for each bit question."
        },
        "max_lies": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of false answers allowed in the transcript."
        },
        "position_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of positions in XOR single-flip communication interactives."
        },
        "message_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of messages in finite communication-code interactives."
        },
        "word_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Length of every codeword in finite word-code interactives."
        },
        "alphabet": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1},
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Three-letter alphabet for erasure-code interactives."
        },
        "codewords": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Codeword table indexed by message number."
        },
        "grid_rows": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of board rows in grid-based finite yes/no protocols."
        },
        "grid_cols": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of board columns in grid-based finite yes/no protocols."
        },
        "person_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of people in finite yes/no question protocols."
        },
        "color_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of hat colors in finite wise-men parity-code interactives."
        },
        "count_values": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "minItems": 2,
          "uniqueItems": true,
          "description": "Allowed color-count values in wise-men color-count parity interactives."
        },
        "sage_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of wise people in hidden-hat-number parity interactives."
        },
        "target_correct_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of correct simultaneous answers required by a protocol interactive."
        },
        "hidden_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of hidden hats or cards in finite communication interactives."
        },
        "target_parity": {
          "type": "string",
          "enum": ["even", "odd"],
          "description": "Permutation parity fixed by the prearranged hidden-hat-number protocol."
        },
        "prisoner_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of prisoners in permutation-cycle and line-hats protocol interactives."
        },
        "box_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of boxes in permutation-cycle or higher/lower game interactives."
        },
        "compare_box_counts": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true,
          "description": "Small higher/lower game sizes shown side by side."
        },
        "people": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true,
          "description": "Named people available as speakers in finite yes/no question protocols."
        },
        "object_labels": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true,
          "description": "Optional viewer labels for named objects."
        },
        "vertices": {
          "type": "array",
          "description": "Graph vertices for moving-target search interactives.",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {"type": "string"},
                  "label": {"type": "string"},
                  "color": {"type": "string"},
                  "x": {"type": "number"},
                  "y": {"type": "number"}
                }
              }
            ]
          }
        },
        "edges": {
          "type": "array",
          "description": "Undirected graph edges as pairs of vertex ids.",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string"}
          }
        },
        "check_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of vertices the user must check on each move."
        },
        "allow_fewer": {
          "type": "boolean",
          "description": "Whether a move may check fewer than check_size vertices."
        },
        "graph_kind": {
          "type": "string",
          "description": "Optional visual/model hint such as cube."
        },
        "pair_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of coin pairs when exactly one light counterfeit is hidden in each pair."
        },
        "counterfeit_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of counterfeit coins in multiple-counterfeit interactives."
        },
        "selected_coin": {
          "type": "integer",
          "minimum": 1,
          "description": "Known selected coin whose hidden type is the target of a detector interactive."
        },
        "real_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of genuine coins in Zoltar-style removal interactives."
        },
        "min_real_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of genuine coins in paid-weighing finite-state interactives."
        },
        "max_real_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of genuine coins in paid-weighing finite-state interactives."
        },
        "coin_pairs": {
          "type": "array",
          "description": "Explicit two-coin pairs for paired counterfeit interactives.",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "pile_sizes": {
          "type": "array",
          "description": "Sizes of piles for safe-pile balance certificate interactives.",
          "minItems": 2,
          "items": {"type": "integer", "minimum": 1}
        },
        "piles": {
          "type": "array",
          "description": "Named piles and optional explicit diamond ids for safe-pile interactives.",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "size"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string"},
              "size": {"type": "integer", "minimum": 1},
              "diamonds": {
                "type": "array",
                "items": {"type": "integer", "minimum": 1},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "array",
          "description": "Explicit groups for grouped counterfeit interactives.",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1},
            "uniqueItems": true
          }
        },
        "counterfeit_per_group": {
          "type": "array",
          "description": "How many light counterfeits are hidden in each group.",
          "items": {"type": "integer", "minimum": 0}
        },
        "counterfeit_weight": {
          "type": "string",
          "enum": ["lighter", "heavier"],
          "description": "Known direction of the single counterfeit coin."
        },
        "max_weighings": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of balance-scale weighings allowed."
        },
        "max_sampled_coins": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of physical coins that may be sampled and reused across numeric weighings."
        },
        "max_tests": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of detector or subset tests allowed."
        },
        "max_openings": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of boxes one prisoner may open in permutation-cycle protocol interactives."
        },
        "target_sum": {
          "type": "integer",
          "minimum": 1,
          "description": "Required sum of numbers in each selected subset-question."
        },
        "objective": {
          "type": "string",
          "enum": ["identify_coin", "identify_coin_after_erasure", "identify_coin_or_none", "identify_coin_only", "identify_coin_only_unknown_direction", "identify_coin_and_sign", "identify_coin_and_direction", "identify_counterfeit_count", "identify_faulty_scale", "identify_heaviest_coin", "identify_fake_bag", "identify_fake_bag_subset", "identify_fake_coin_set", "identify_light_and_heavy_counterfeit_coins", "identify_selected_bag_weight", "identify_selected_coin_type", "identify_deficient_bag_or_none", "identify_hidden_card", "identify_hidden_pair", "identify_hidden_number", "recover_hidden_password", "identify_key_position", "identify_magic_subset", "identify_state", "identify_swap_or_none", "identify_liar", "identify_one_from_each_pair", "identify_one_light_coin", "identify_one_counterfeit_coin", "identify_one_genuine_coin", "identify_one_genuine_coin_not_removed", "identify_one_weight", "identify_all_weights", "identify_all_weights_after_rotation", "identify_safe_pile", "identify_line_or_all_counterfeits", "identify_all_counterfeits", "verify_all_weights_equal", "detect_presence_and_sign", "capture_hidden_moving_target", "decode_hidden_message", "identify_selected_card", "all_agents_find_own_state", "maximize_win_probability", "guarantee_all_but_first_correct", "guarantee_at_least_half_correct", "identify_spectator_card", "prove_impossible"],
          "description": "Goal checked by the interactive layer."
        },
        "hidden_states": {
          "type": "array",
          "description": "Explicit finite hidden states for constrained light-counterfeit-set interactives.",
          "items": {
            "type": "object",
            "required": ["coins"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "coins": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 1},
                "uniqueItems": true
              }
            }
          }
        },
        "layout": {
          "type": "string",
          "enum": ["generic", "line", "circle", "grid", "two_people_three_coins"],
          "description": "Preferred visual layout for finite coin-set interactives."
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["random", "cheater", "exhaustive", "challenge", "sandbox", "guided", "manual_spectator"]
          },
          "uniqueItems": true
        },
        "adaptive": {
          "type": "boolean",
          "description": "Whether later tests or weighings may depend on earlier outcomes."
        },
        "require_equal_pan_counts": {
          "type": "boolean",
          "description": "Whether the UI should require the two pans to contain the same number of coins before weighing."
        },
        "erasure_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of fixed weighing results that may be lost or erased while the nonadaptive table must still identify the state."
        },
        "preset_weighings": {
          "type": "array",
          "description": "Fixed balance-scale weighings shown and checked by nonadaptive interactives.",
          "items": {
            "type": "object",
            "properties": {
              "left": {
                "type": "array",
                "items": {"type": "integer", "minimum": 1},
                "uniqueItems": true
              },
              "right": {
                "type": "array",
                "items": {"type": "integer", "minimum": 1},
                "uniqueItems": true
              }
            }
          }
        },
        "known_genuine_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of known genuine comparison coins available in addition to suspicious coins."
        },
        "has_known_genuine": {
          "type": "boolean",
          "description": "Shortcut flag for a single known genuine comparison coin."
        },
        "scale_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of balance-scale instruments when the hidden state is a faulty instrument."
        },
        "detector_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of binary detector instruments when one detector may answer arbitrarily."
        },
        "faulty_scale_count": {
          "type": "integer",
          "const": 1,
          "description": "Number of faulty scale instruments."
        },
        "broken_scale_count": {
          "type": "integer",
          "const": 1,
          "description": "Number of broken scale instruments when the hidden state also includes a counterfeit coin."
        },
        "broken_detector_count": {
          "type": "integer",
          "const": 1,
          "description": "Number of broken binary detector instruments."
        },
        "scale_labels": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true,
          "description": "Optional labels for scale instruments."
        },
        "detector_labels": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true,
          "description": "Optional labels for detector instruments."
        },
        "weighable_objects": {
          "type": "string",
          "enum": ["scales", "coins"],
          "description": "Objects that can be placed on the pans in a faulty-scale interactive."
        },
        "bag_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of bags in a numeric linear-signature weighing interactive."
        },
        "bag_weights": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0},
          "description": "Nominal written weights for bags in balanced-weight signature interactives."
        },
        "fake_bag_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of fake bags/stacks when the numeric linear-signature state space is not an arbitrary subset."
        },
        "counterfeit_delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Known per-coin weight difference for fake coins in numeric linear-signature interactives."
        },
        "reliable_difference": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Minimum absolute mass difference that a threshold balance reports reliably."
        },
        "genuine_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Known genuine coin weight used to display numeric scale readings."
        },
        "state_model": {
          "type": "string",
          "enum": ["fake_bag_subset", "single_fake_bag", "fixed_fake_count", "selected_bag_weight", "explicit_fake_sets"],
          "description": "Hidden-state model for numeric linear-signature interactives."
        },
        "observation_model": {
          "type": "string",
          "enum": ["deficit_residue", "actual_weight", "projective_signed_deviation"],
          "description": "Numeric observation model for linear-signature interactives."
        },
        "object_kind": {
          "type": "string",
          "enum": ["bag", "stack", "coin"],
          "description": "Viewer label family for numeric linear-signature objects."
        },
        "selection_model": {
          "type": "string",
          "enum": ["quantities", "subset", "signed_quantities"],
          "description": "Whether each numeric weighing uses per-object quantities or a selected subset."
        },
        "allow_empty_subset": {
          "type": "boolean",
          "description": "Whether the hidden fake-bag subset may be empty."
        },
        "protocol": {
          "type": "string",
          "enum": ["one_liar_line_neighborhood", "knight_liar_fake_coin_subset", "adjacent_pair_grid_search"],
          "description": "Built-in finite yes/no protocol model."
        },
        "action_subset_sizes": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true,
          "description": "Allowed subset sizes for finite coin-question actions."
        },
        "query_includes_self": {
          "type": "boolean",
          "description": "Whether the line-neighborhood question includes the person being asked."
        },
        "answer_labels": {
          "type": "object",
          "properties": {
            "yes": {"type": "string"},
            "no": {"type": "string"}
          },
          "additionalProperties": false
        },
        "exclude_all_fake": {
          "type": "boolean",
          "description": "Whether the all-bags-fake state is excluded from the hidden state space."
        },
        "weight_model": {
          "type": "string",
          "enum": ["permutation_1_to_N", "equal_halves_binary"],
          "description": "Weight assignment model for expert-judge certificate interactives."
        },
        "certificate_goal": {
          "type": "string",
          "enum": ["one_forced_weight", "all_forced_weights"],
          "description": "What the judge must be able to infer from the certificate."
        },
        "light_weight": {
          "type": "integer",
          "minimum": 1,
          "description": "Lower weight in a two-weight expert-judge certificate."
        },
        "heavy_weight": {
          "type": "integer",
          "minimum": 1,
          "description": "Higher weight in a two-weight expert-judge certificate."
        },
        "light_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of lower-weight objects in a two-weight expert-judge certificate."
        },
        "heavy_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of higher-weight objects in a two-weight expert-judge certificate."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "single_counterfeit_weighing"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "counterfeit_weight", "max_weighings", "objective"]
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "single_counterfeit_unknown_direction"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "max_weighings", "objective"],
            "properties": {
              "objective": {"enum": ["identify_coin", "identify_coin_only", "identify_coin_only_unknown_direction", "identify_coin_and_sign", "identify_coin_and_direction", "identify_sign_only", "identify_sign_only_unknown_direction"]}
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "opposite_counterfeit_pair_weighing"}},
            "required": ["type"]
          },
          "then": {
