{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incomplete Information Problem",
  "type": "object",
  "required": [
    "id",
    "title",
    "fragment",
    "kind",
    "language",
    "statements",
    "ideas",
    "strategies",
    "difficulty",
    "tags",
    "sources",
    "editorial"
  ],
  "$defs": {
    "figure": {
      "type": "object",
      "description": "Local image attached to a statement, idea, strategy, or proof. Images are stored as files, not embedded as base64.",
      "required": ["asset", "alt", "caption", "status"],
      "anyOf": [
        {"required": ["source_id"]},
        {"required": ["source_note"]}
      ],
      "properties": {
        "id": {"type": "string"},
        "asset": {
          "type": "string",
          "description": "Safe repository-relative path such as data/assets/images/<problem-id>/<name>.webp."
        },
        "alt": {"type": "string"},
        "caption": {"type": "string"},
        "source_id": {"type": "string"},
        "source_note": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "figure_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/figure"}
    }
  },
  "properties": {
    "statements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "figures": {"$ref": "#/$defs/figure_list"}
          }
        }
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figures": {"$ref": "#/$defs/figure_list"}
        }
      }
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figures": {"$ref": "#/$defs/figure_list"}
        }
      }
    },
    "impossibility_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figures": {"$ref": "#/$defs/figure_list"}
        }
      }
    },
    "fragment": {
      "type": "string",
      "description": "Primary navigation fragment: weighings, wise_people, card_tricks, questions, communication, impossibility."
    },
    "authors": {
      "type": "array",
      "description": "Known problem authors/proposers. Use only when backed by a source; unknown authors should be omitted.",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string"},
              "status": {"type": "string"},
              "source_id": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        ]
      }
    },
    "incomplete_information_profile": {
      "type": "object",
      "properties": {
        "hidden_state_space": {"type": "string"},
        "observations": {"type": "array", "items": {"type": "string"}},
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "goal": {"type": "array", "items": {"type": "string"}},
        "strategy_type": {"type": "array", "items": {"type": "string"}},
        "lower_bound_method": {"type": "array", "items": {"type": "string"}},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string"}
      }
    },
    "weighing_profile": {
      "type": "object",
      "properties": {
        "object_count": {"type": "integer"},
        "counterfeit_count": {"type": "integer"},
        "counterfeit_type": {"type": "string"},
        "weighing_count": {"type": "integer"},
        "outcome_count_per_weighing": {"type": "integer"},
        "adaptive": {"type": "boolean"},
        "objective": {"type": "string"}
      }
    },
    "interactive": {
      "type": "object",
      "description": "Optional viewer-side interactive task configuration. It must not contain solution steps or strategic hints.",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Renderer key used by the static viewer."
        },
        "coin_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of visually identical numbered coins."
        },
        "pair_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of coin pairs when exactly one light counterfeit is hidden in each pair."
        },
        "counterfeit_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of counterfeit coins in multiple-counterfeit interactives."
        },
        "coin_pairs": {
          "type": "array",
          "description": "Explicit two-coin pairs for paired counterfeit interactives.",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "groups": {
          "type": "array",
          "description": "Explicit groups for grouped counterfeit interactives.",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1},
            "uniqueItems": true
          }
        },
        "counterfeit_per_group": {
          "type": "array",
          "description": "How many light counterfeits are hidden in each group.",
          "items": {"type": "integer", "minimum": 0}
        },
        "counterfeit_weight": {
          "type": "string",
          "enum": ["lighter", "heavier"],
          "description": "Known direction of the single counterfeit coin."
        },
        "max_weighings": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of balance-scale weighings allowed."
        },
        "max_tests": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of binary detector tests allowed."
        },
        "objective": {
          "type": "string",
          "enum": ["identify_coin", "identify_coin_only", "identify_coin_only_unknown_direction", "identify_coin_and_sign", "identify_coin_and_direction", "identify_faulty_scale", "identify_heaviest_coin", "identify_fake_bag", "identify_fake_bag_subset", "identify_fake_coin_set", "identify_one_from_each_pair", "identify_one_light_coin", "identify_all_counterfeits", "prove_impossible"],
          "description": "Goal checked by the interactive layer."
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["random", "cheater", "exhaustive", "challenge", "sandbox", "guided"]
          },
          "uniqueItems": true
        },
        "require_equal_pan_counts": {
          "type": "boolean",
          "description": "Whether the UI should require the two pans to contain the same number of coins before weighing."
        },
        "known_genuine_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of known genuine comparison coins available in addition to suspicious coins."
        },
        "has_known_genuine": {
          "type": "boolean",
          "description": "Shortcut flag for a single known genuine comparison coin."
        },
        "scale_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of balance-scale instruments when the hidden state is a faulty instrument."
        },
        "detector_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of binary detector instruments when one detector may answer arbitrarily."
        },
        "faulty_scale_count": {
          "type": "integer",
          "const": 1,
          "description": "Number of faulty scale instruments."
        },
        "broken_scale_count": {
          "type": "integer",
          "const": 1,
          "description": "Number of broken scale instruments when the hidden state also includes a counterfeit coin."
        },
        "broken_detector_count": {
          "type": "integer",
          "const": 1,
          "description": "Number of broken binary detector instruments."
        },
        "scale_labels": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true,
          "description": "Optional labels for scale instruments."
        },
        "detector_labels": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true,
          "description": "Optional labels for detector instruments."
        },
        "weighable_objects": {
          "type": "string",
          "enum": ["scales", "coins"],
          "description": "Objects that can be placed on the pans in a faulty-scale interactive."
        },
        "bag_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Number of bags in a numeric linear-signature weighing interactive."
        },
        "fake_bag_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of fake bags/stacks when the numeric linear-signature state space is not an arbitrary subset."
        },
        "counterfeit_delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Known per-coin weight difference for fake coins in numeric linear-signature interactives."
        },
        "genuine_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Known genuine coin weight used to display numeric scale readings."
        },
        "state_model": {
          "type": "string",
          "enum": ["fake_bag_subset", "single_fake_bag", "fixed_fake_count"],
          "description": "Hidden-state model for numeric linear-signature interactives."
        },
        "observation_model": {
          "type": "string",
          "enum": ["deficit_residue", "actual_weight"],
          "description": "Numeric observation model for linear-signature interactives."
        },
        "object_kind": {
          "type": "string",
          "enum": ["bag", "stack", "coin"],
          "description": "Viewer label family for numeric linear-signature objects."
        },
        "selection_model": {
          "type": "string",
          "enum": ["quantities", "subset"],
          "description": "Whether each numeric weighing uses per-object quantities or a selected subset."
        },
        "allow_empty_subset": {
          "type": "boolean",
          "description": "Whether the hidden fake-bag subset may be empty."
        },
        "exclude_all_fake": {
          "type": "boolean",
          "description": "Whether the all-bags-fake state is excluded from the hidden state space."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "single_counterfeit_weighing"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "counterfeit_weight", "max_weighings", "objective"]
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "single_counterfeit_unknown_direction"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "max_weighings", "objective"],
            "properties": {
              "objective": {"enum": ["identify_coin", "identify_coin_only", "identify_coin_only_unknown_direction", "identify_coin_and_sign", "identify_coin_and_direction"]}
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "paired_light_counterfeits"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "pair_count", "max_weighings", "objective"],
            "properties": {
              "objective": {"enum": ["identify_one_from_each_pair"]}
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "multiple_light_find_one"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "counterfeit_count", "max_weighings", "objective"],
            "properties": {
              "objective": {"enum": ["identify_one_light_coin"]}
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "grouped_light_counterfeits"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "counterfeit_count", "groups", "counterfeit_per_group", "max_weighings", "objective"],
            "properties": {
              "objective": {"enum": ["identify_all_counterfeits"]}
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "faulty_scale_identification"}},
            "required": ["type"]
          },
          "then": {
            "required": ["scale_count", "faulty_scale_count", "max_weighings", "objective", "weighable_objects"],
            "properties": {
              "objective": {"enum": ["identify_faulty_scale"]}
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "broken_scale_counterfeit_coin"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "scale_count", "broken_scale_count", "counterfeit_weight", "max_weighings", "objective"],
            "properties": {
              "objective": {"enum": ["identify_coin"]},
              "counterfeit_weight": {"enum": ["lighter", "heavier"]}
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "broken_detector_counterfeit_coin"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "detector_count", "broken_detector_count", "max_tests", "objective"],
            "properties": {
              "objective": {"enum": ["identify_coin"]}
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "heaviest_coin_one_broken_scale"}},
            "required": ["type"]
          },
          "then": {
            "required": ["coin_count", "scale_count", "broken_scale_count", "max_weighings", "objective", "weighable_objects"],
            "properties": {
              "objective": {"enum": ["identify_heaviest_coin"]},
              "weighable_objects": {"enum": ["coins"]}
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "numeric_linear_signature"}},
            "required": ["type"]
          },
          "then": {
            "required": ["bag_count", "max_weighings", "objective"],
            "properties": {
              "objective": {"enum": ["identify_fake_bag", "identify_fake_bag_subset", "identify_fake_coin_set"]}
            }
          }
        }
      ]
    },
    "knowledge_profile": {"type": "object"},
    "card_trick_profile": {"type": "object"},
    "questions_profile": {"type": "object"},
    "communication_profile": {"type": "object"}
  }
}
