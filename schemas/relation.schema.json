{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relation",
  "type": "object",
  "required": [
    "id",
    "from",
    "to",
    "type",
    "distance",
    "forward_text",
    "backward_text",
    "status",
    "confidence"
  ],
  "properties": {
    "id": {"type": "string"},
    "from": {"type": "string"},
    "to": {"type": "string"},
    "type": {
      "type": "string",
      "enum": [
        "same_mechanism",
        "strategy_transfer",
        "lower_bound_analogy",
        "heavy_external_theorem",
        "generalization",
        "special_case",
        "variant",
        "contrast",
        "teaches_before"
      ]
    },
    "distance": {"type": "integer", "minimum": 1},
    "forward_text": {"type": "string", "minLength": 1},
    "backward_text": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"const": "generalization"}},
        "required": ["type"]
      },
      "then": {
        "properties": {"distance": {"const": 1}}
      }
    }
  ]
}
